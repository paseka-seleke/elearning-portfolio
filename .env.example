SITE_BASE_URL=https://paseka.africa

# Contact form email, sent via Resend (https://resend.com).
RESEND_API_KEY=
CONTACT_EMAIL=me@paseka.africa
# Must be on a domain verified in Resend (paseka.africa is verified as of
# 2026-10-01). Leave unset to fall back to Resend's shared sandbox sender
# (onboarding@resend.dev), which can only deliver to the Resend account's
# own email, not production use.
CONTACT_FROM_EMAIL=Paseka Seleke <hello@paseka.africa>

# Contact form bot protection via hCaptcha (https://dashboard.hcaptcha.com).
# Leave both unset to skip the captcha entirely (e.g. local development).
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# /admin blog login. Login is disabled until ADMIN_PASSWORD is set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the admin login cookie. Set this in production so sessions survive a
# restart, any long random string works, e.g. generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
